# ====================================================================
# Federated SOC/SOAR Laboratory - Custom Local NIDS Rules
# ====================================================================

# 1. RDP Brute-Force Connection Flood (Hydra/Ncrack Detection)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"SOC LAB - High Frequency Inbound RDP Connections (Possible Hydra Brute-Force)"; flow:to_server,established; threshold: type threshold, track by_src, count 5, seconds 10; classtype:suspicious-login; sid:1000001; rev:1;)

# 2. Mimikatz Binary Download over HTTP
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC LAB - Executable Download Detected (mimikatz.exe)"; flow:to_client,established; file.name; content:"mimikatz.exe"; nocase; classtype:trojan-activity; sid:1000002; rev:1;)

# 3. Suspicious Inbound SMB Traffic from Attack Subnet
alert smb $EXTERNAL_NET any -> $HOME_NET 445 (msg:"SOC LAB - Suspicious Inbound SMB Admin Session"; flow:to_server,established; classtype:bad-unknown; sid:1000003; rev:1;)
